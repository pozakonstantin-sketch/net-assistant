# Нормализация окончаний строк.
# Скрипты для Linux (ВМ, Termux) обязаны иметь LF, иначе bash падает с
# "bad interpreter: /usr/bin/env bash^M".
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.webmanifest text eol=lf

# PowerShell-скрипты под Windows
*.ps1   text eol=crlf

# Бинарные файлы
*.png   binary
*.jpg   binary
*.ico   binary
*.apk   binary
*.zip   binary
*.gz    binary
