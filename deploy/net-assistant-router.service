[Unit]
Description=Net Assistant router agent — управление роутером по SSH
Documentation=file:///opt/net-assistant/docs/VM_SETUP.md
After=network-online.target net-assistant-core.service
Wants=net-assistant-core.service

[Service]
Type=simple
User=assistant
WorkingDirectory=/opt/net-assistant
EnvironmentFile=/opt/net-assistant/.env
ExecStart=/opt/net-assistant/.venv/bin/python -m agents.router_agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
