# ────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните. .env НЕ коммитить.
# ────────────────────────────────────────────────────────────────

# Общий секрет: агенты и клиенты авторизуются им. Сгенерировать:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ASSISTANT_TOKEN=change-me-please

# Адрес ядра (для агентов). Если ядро на этом же ПК:
CORE_URL=ws://127.0.0.1:8787
# При работе через Tailscale укажите Tailscale-адрес ядра, например:
# CORE_URL=ws://100.101.102.103:8787

# ── Ядро: HTTP-сервер ──────────────────────────────────────────
CORE_HOST=0.0.0.0
CORE_PORT=8787

# ── LLM (OpenAI-совместимый API) ───────────────────────────────
# Режим планировщика: auto | opencode | openai.
# auto: есть LLM_API_KEY → облако, иначе бесплатные модели OpenCode (CLI в этой же машине).
LLM_BACKEND=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ── Бесплатные модели OpenCode (используются при LLM_BACKEND=auto/opencode) ──
# Установка: curl -fsSL https://opencode.ai/install | bash
OPENCODE_BIN=/home/assistant/.opencode/bin/opencode
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
OPENCODE_TIMEOUT=150
# ВАЖНО: оставьте пустым. Свои агенты и opencode.json бесплатный тариф отклоняет (403).
OPENCODE_AGENT=

# Выполнять опасные действия только после подтверждения (рекомендуется true)
REQUIRE_CONFIRM=true

# ── Голос (распознавание речи) ─────────────────────────────────
# auto   — облако при наличии ключа, иначе локальный faster-whisper
# openai — только облако (OpenAI-совместимый /audio/transcriptions)
# local  — только локально (pip install faster-whisper)
STT_ENGINE=auto
STT_BASE_URL=https://api.openai.com/v1
# если пусто, используется LLM_API_KEY
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=ru
STT_MAX_MB=20
# для локального режима: tiny|base|small|medium|large-v3
STT_LOCAL_MODEL=small

# Список разрешённых device_id (пусто = разрешить все, у кого верный токен)
ALLOWED_DEVICES=

# ── Агент ПК (Windows) ─────────────────────────────────────────
PC_DEVICE_ID=pc-desktop
PC_DEVICE_NAME=Мой ПК
# Разрешённые первые слова команд в shell.run (через запятую)
PC_SHELL_ALLOW=dir,ipconfig,ping,tasklist,whoami,systeminfo,netstat,arp,nslookup,tracert,hostname,where,echo,type,findstr,tree,Get-Date,Get-Process,Get-Service,Get-Volume,Get-CimInstance
# Каталоги, которые агенту разрешено читать (через ;)
PC_FS_ROOTS=C:\Users\monstradamus

# ── Агент Android (Termux) ─────────────────────────────────────
ANDROID_DEVICE_ID=phone
ANDROID_DEVICE_NAME=Мой телефон

# ── Агент роутера ──────────────────────────────────────────────
# Агент живёт в ВМ и ходит на роутер по SSH (на самом роутере Python не нужен).
ROUTER_DEVICE_ID=router
ROUTER_DEVICE_NAME=Роутер
ROUTER_HOST=192.168.1.1
ROUTER_PORT=22
ROUTER_USER=root
ROUTER_PASSWORD=
ROUTER_KEY_PATH=
# openwrt | keenetic | asus | mikrotik
ROUTER_KIND=openwrt
# WiFi-интерфейс для iw/ubus hostapd: на OpenWrt 25.x это phy0-ap0.
# Узнать: ssh root@192.168.1.1 iwinfo | grep -E '^phy'
ROUTER_WIFI_IF=phy0-ap0
