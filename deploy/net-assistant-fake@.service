[Unit]
Description=Net Assistant fake agent (%i) — тестовое устройство
After=network-online.target net-assistant-core.service
Wants=net-assistant-core.service

[Service]
Type=simple
User=assistant
WorkingDirectory=/opt/net-assistant
EnvironmentFile=/opt/net-assistant/.env
Environment=FAKE_KIND=%i
Environment=FAKE_DEVICE_ID=fake-%i
ExecStart=/opt/net-assistant/.venv/bin/python -m agents.fake_agent
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
